PORT=3000
DATABASE_URL=postgres://wallet:wallet@localhost:5433/wallet

# At least 32 characters; the app refuses to start until this is replaced. openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600

# At least 16 characters, sent as the x-admin-key header on /admin routes
ADMIN_API_KEY=change-me

# karma = Lendsqr Adjutor Karma API, mock = local list below
BLACKLIST_PROVIDER=mock
ADJUTOR_BASE_URL=https://adjutor.lendsqr.com/v2
ADJUTOR_API_KEY=
MOCK_BLACKLIST=blacklisted@example.com,+2348000000000
