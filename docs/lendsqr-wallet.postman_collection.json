{
  "info": {
    "name": "Lendsqr wallet service",
    "description": "Manual test flow. Run top to bottom: signup Ada and Bob (tokens and wallet ids are captured automatically), deposit, transfer, replay, block, reconcile. Set baseUrl and adminKey in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lendsqr-wallet-service-wg2b.onrender.com"
    },
    {
      "key": "adminKey",
      "value": "paste ADMIN_API_KEY from Render > Environment (or .env locally)"
    },
    {
      "key": "adaToken",
      "value": ""
    },
    {
      "key": "adaUserId",
      "value": ""
    },
    {
      "key": "adaWalletId",
      "value": ""
    },
    {
      "key": "bobToken",
      "value": ""
    },
    {
      "key": "bobUserId",
      "value": ""
    },
    {
      "key": "bobWalletId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Unique identities per run so signup never hits the 409 duplicate rule.",
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', String(Date.now()).slice(-8));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 Health",
      "item": [
        {
          "name": "GET / (service info)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "GET /health (checks the database)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1 Accounts",
      "item": [
        {
          "name": "POST /auth/signup  Ada (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('adaToken', b.accessToken);",
                  "pm.collectionVariables.set('adaUserId', b.user.id);",
                  "pm.collectionVariables.set('adaWalletId', b.wallet.id);",
                  "pm.test('201 with wallet at 0', () => { pm.response.to.have.status(201); pm.expect(b.wallet.balance).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada{{runId}}@example.com\",\n  \"phoneNumber\": \"+23480{{runId}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Obi\",\n  \"password\": \"correct-horse-battery\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/signup  Bob (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bobToken', b.accessToken);",
                  "pm.collectionVariables.set('bobUserId', b.user.id);",
                  "pm.collectionVariables.set('bobWalletId', b.wallet.id);",
